# ══════════════════════════════════════════════════════════════
#  ALGO TRADING BOT — Environment Variables
#  ─────────────────────────────────────────
#  HOW TO USE:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in your real values below
#    3. NEVER commit .env to Git — it's already in .gitignore
# ══════════════════════════════════════════════════════════════

# ─── MT5 BROKER ── REQUIRED ────────────────────────────────────
# Get from: Vantage broker portal → My Accounts → Account Details
# OR: Exness Personal Area → My Accounts
MT5_ACCOUNT=12345678                    # Your MT5 account number (digits only)
MT5_PASSWORD=your_mt5_password          # MT5 account password (not portal login)
MT5_SERVER=VantageInternational-Demo    # Exact server name from MT5 login screen
                                        # Examples:
                                        #   Vantage Demo:  VantageInternational-Demo
                                        #   Vantage Live:  VantageInternational-Live
                                        #   Exness Demo:   Exness-MT5Demo
                                        #   Exness Live:   Exness-MT5Real

# ─── TELEGRAM NOTIFICATIONS ── RECOMMENDED ────────────────────
# How to get:
#   1. Open Telegram → search @BotFather → /newbot → get TOKEN
#   2. Open Telegram → search @userinfobot → send any msg → get CHAT_ID
TELEGRAM_TOKEN=123456789:ABCDefGhIJKlmNoPQRstuVwXyz
TELEGRAM_CHAT_ID=123456789

# ─── PINECONNECTOR ── REQUIRED IF USING ROUTE A ───────────────
# Get from: pineconnector.com → Dashboard → Your License Key
PINECONNECTOR_LICENSE=your_pineconnector_license_key

# ─── WEBHOOK SECURITY ── RECOMMENDED ──────────────────────────
# Set any random secret string. Add the same to TradingView alert headers.
# Leave empty to disable signature verification (not recommended for production).
WEBHOOK_SECRET=mysecretwebhookkey123

# ─── RISK MANAGEMENT ── CUSTOMIZABLE ──────────────────────────
MAX_RISK_PER_TRADE=2.0      # Max % of balance to risk on a single trade
MAX_DAILY_LOSS_PCT=5.0      # Halt all trading if daily loss exceeds this %
MAX_OPEN_POSITIONS=5        # Never hold more than this many open trades
DEFAULT_RISK_PCT=1.0        # Default risk % if not specified in signal
RR_RATIO=2.0                # Minimum risk:reward ratio (1:2 = 2.0)
ATR_MULTIPLIER=1.5          # Stop loss = ATR × this value

# ─── TRADING SYMBOLS WHITELIST ── COMMA SEPARATED ─────────────
# Only signals for these symbols will be accepted. Others are rejected.
ALLOWED_SYMBOLS=EURUSD,GBPUSD,XAUUSD,USDJPY,BTCUSD

# ─── SERVER ───────────────────────────────────────────────────
PORT=5000
LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════
#  TRADINGVIEW ALERT JSON TEMPLATE (paste in TradingView alert box)
#  Webhook URL:  https://YOUR-BOT-URL.onrender.com/webhook
#
#  {"action":"buy","symbol":"EURUSD","sl":1.0800,"tp":1.0900,"risk_pct":1.0}
#  {"action":"sell","symbol":"XAUUSD","sl":2050.0,"tp":1990.0,"risk_pct":1.0}
#
#  PINECONNECTOR ALERT TEMPLATE (paste in TradingView alert box)
#  Webhook URL:  https://webhook.pineconnector.com
#
#  YOUR_LICENSE,buy,EURUSD,vol_pct_bal_loss=1,sl_pips=50,tp_pips=100
# ══════════════════════════════════════════════════════════════
