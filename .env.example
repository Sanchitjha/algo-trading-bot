# ─── MT5 Broker Credentials ─────────────────────────────────
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=VantageInternational-Demo

# ─── Webhook Security ───────────────────────────────────────
# Optional: set a secret to verify incoming webhooks via HMAC
WEBHOOK_SECRET=your_webhook_secret_here

# ─── Telegram Notifications ─────────────────────────────────
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# ─── Risk Management ─────────────���──────────────────────────
MAX_RISK_PER_TRADE=2.0
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=5
DEFAULT_RISK_PCT=1.0

# ─── Trading ───────���────────────────────────────────────────
ALLOWED_SYMBOLS=EURUSD,GBPUSD,XAUUSD,USDJPY,BTCUSD

# ─── Server ─���───────────────────────────────────────────────
PORT=5000
LOG_LEVEL=INFO
