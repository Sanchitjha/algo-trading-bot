# Algo Trading Bot - Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env to Git!
# Get MT5 creds from Vantage/Exness demo/live account
# Telegram: @BotFather for token, @userinfobot for chat_id

# ─── MT5 BROKER (Required) ─────────────────────────────────────
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=VantageInternational-Demo  # or Exness-MT5Demo

# ─── TELEGRAM NOTIFICATIONS (Optional but recommended) ────────
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# ─── WEBHOOK SECURITY (Recommended) ───────────────────────────
WEBHOOK_SECRET=mysecretwebhookkey123

# ─── RISK MANAGEMENT (Customizable) ───────────────────────────
MAX_RISK_PER_TRADE=2.0
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=5
DEFAULT_RISK_PCT=1.0
RR_RATIO=2.0
ATR_MULTIPLIER=1.5

# ─── TRADING SYMBOLS (Whitelist - Comma separated) ────────────
ALLOWED_SYMBOLS=EURUSD,GBPUSD,XAUUSD,USDJPY,BTCUSD

# ─── SERVER ───────────────────────────────────────────────────
PORT=5000
LOG_LEVEL=INFO

# TradingView Alert JSON example:
# {"action":"buy","symbol":"EURUSD","sl":1.0800,"tp":1.0900,"risk_pct":1.0}
