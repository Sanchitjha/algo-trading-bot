//@version=6
strategy("Algo Position 4H — Multi-Timeframe Trend", overlay=true,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=2,
         commission_type=strategy.commission.percent,
         commission_value=0.05,
         slippage=2,
         calc_on_every_tick=false)

// ─── INPUTS ────────────────────────────────────────────────────
rsi_len     = input.int(14,   "RSI Length",        minval=1)
rsi_ob      = input.int(65,   "RSI Overbought (relaxed for 4H)")
rsi_os      = input.int(35,   "RSI Oversold (relaxed for 4H)")
ema_fast    = input.int(9,    "EMA Fast",          minval=1)
ema_slow    = input.int(21,   "EMA Slow",          minval=1)
ema_trend   = input.int(50,   "EMA 50 (Trend)")
macd_fast   = input.int(12,   "MACD Fast")
macd_slow   = input.int(26,   "MACD Slow")
macd_signal = input.int(9,    "MACD Signal")
atr_len     = input.int(14,   "ATR Length")
atr_mult    = input.float(2.0, "ATR SL Multiplier (wider for 4H)")
rr_ratio    = input.float(2.5, "Risk:Reward Ratio")

// ─── MULTI-TIMEFRAME: Check Daily trend ────────────────────────
daily_ema_50  = request.security(syminfo.tickerid, "D", ta.ema(close, 50))
daily_ema_200 = request.security(syminfo.tickerid, "D", ta.ema(close, 200))
daily_bullish = daily_ema_50 > daily_ema_200
daily_bearish = daily_ema_50 < daily_ema_200

// ─── 4H INDICATORS ─────────────────────────────────────────────
rsi_val  = ta.rsi(close, rsi_len)
ema_f    = ta.ema(close, ema_fast)
ema_s    = ta.ema(close, ema_slow)
ema_50   = ta.ema(close, ema_trend)
[macd_l, sig_l, hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)
atr_val  = ta.atr(atr_len)

// ─── SIGNAL CONDITIONS (multi-timeframe confluence) ─────────────
// 4H trend + Daily trend must agree
bull_trend  = ema_f > ema_s and close > ema_50 and daily_bullish
bear_trend  = ema_f < ema_s and close < ema_50 and daily_bearish

rsi_buy     = ta.crossover(rsi_val, rsi_os)
macd_buy    = ta.crossover(macd_l, sig_l)
buy_signal  = bull_trend and (rsi_buy or macd_buy)

rsi_sell    = ta.crossunder(rsi_val, rsi_ob)
macd_sell   = ta.crossunder(macd_l, sig_l)
sell_signal = bear_trend and (rsi_sell or macd_sell)

// ─── ATR SL/TP (wider for position trading) ────────────────────
sl_dist  = atr_val * atr_mult
tp_dist  = sl_dist * rr_ratio

long_sl  = close - sl_dist
long_tp  = close + tp_dist
short_sl = close + sl_dist
short_tp = close - tp_dist

// ─── ENTRIES ────────────────────────────────────────────────────
if buy_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=long_sl, limit=long_tp)
    alert('{"action":"buy","symbol":"' + syminfo.ticker + '","sl":' + str.tostring(long_sl) + ',"tp":' + str.tostring(long_tp) + ',"risk_pct":1.5,"comment":"Position 4H MTF"}', alert.freq_once_per_bar_close)

if sell_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=short_sl, limit=short_tp)
    alert('{"action":"sell","symbol":"' + syminfo.ticker + '","sl":' + str.tostring(short_sl) + ',"tp":' + str.tostring(short_tp) + ',"risk_pct":1.5,"comment":"Position 4H MTF"}', alert.freq_once_per_bar_close)

// ─── PLOTS ──────────────────────────────────────────────────────
plot(ema_f,  "EMA 9",  color.new(color.blue, 0),   linewidth=1)
plot(ema_s,  "EMA 21", color.new(color.orange, 0), linewidth=2)
plot(ema_50, "EMA 50", color.new(color.white, 20), linewidth=3)

// Daily trend background
bgcolor(daily_bullish ? color.new(color.green, 93) : daily_bearish ? color.new(color.red, 93) : na, title="Daily Trend")

plotshape(buy_signal,  "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.normal)
plotshape(sell_signal, "SELL", shape.triangledown, location.abovebar, color.red,   size=size.normal)
